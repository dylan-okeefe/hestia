[Unit]
Description=Hestia Telegram Coding-Agent Bridge (Pi RPC + local inference)
After=network.target
# L233: deliberately NO Wants/After on hestia-serve.service or any model
# service. This daemon fronts the coding-agent Telegram bot and must keep
# working while hestia serve (and any given inference backend) is stopped.
# The coding agent talks to whatever OpenAI-compatible endpoint Pi is
# configured for in ~/.pi/agent/models.json.

[Service]
Type=simple
WorkingDirectory=%h/Hestia-runtime
EnvironmentFile=%h/.config/hestia-tg-agent/token.env
Environment="HESTIA_TG_AGENT_CHATS=8550496999,8569861468"
# pi (nvm) and kimi (~/.kimi-code/bin) are not on the systemd user PATH —
# the bridge spawns both as subprocesses.
Environment="PATH=%h/.nvm/versions/node/v24.18.0/bin:%h/.kimi-code/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Unblocks small-coder's websearch/webfetch tools (network-gate extension).
# Note: websearch queries three hardcoded PUBLIC SearXNG instances — queries
# and client IP go to third-party servers. Self-hosted SearXNG on the Proxmox
# box is the privacy upgrade path when the voice migration lands.
Environment="TG_AGENT_ALLOW_NETWORK=1"
ExecStart=%h/.local/bin/uv run --quiet hestia --config config.coder-bot.py coder-bot
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
LimitNOFILE=65536
KillMode=mixed
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
